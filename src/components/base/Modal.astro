---
// src/components/base/Modal.astro
const { isOpen, onClose, title } = Astro.props;
---

{isOpen && (
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50">
    <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg w-full max-w-md p-6">
      <h2 class="text-xl font-semibold text-slate-700 dark:text-slate-300 mb-4">{title}</h2>
      <slot />
      <button onclick={onClose} class="absolute top-4 right-4 text-slate-500 hover:text-slate-700">
        &times;
      </button>
    </div>
  </div>
)}