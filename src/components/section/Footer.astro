---
import Container from "@components/section/Container.astro";
import Logo from "@components/base/Logo.astro";
---

<footer class="font-sans bg-white dark:bg-muted-900">
  <Container>
    <div class="px-5 py-24 mx-auto">
      <div class="flex flex-wrap md:text-left text-center -mb-10 -mx-4">
        <div class="w-full mb-10 ltablet:mb-0 lg:mb-0 ltablet:w-2/6 lg:w-2/6 px-4">
          <div class="max-w-[280px] mx-auto md:mx-0">
            <a
              href="/"
              class="flex items-center justify-center md:justify-start gap-3 mb-4"
            >
              <div class="text-primary-600 transition-all duration-300">
                <Logo class="'w-9 h-9'" />
              </div>
              <span
                class="font-sans text-lg tracking-widest uppercase text-muted-800 dark:text-muted-100"
                >MEDISYNC</span
              >
            </a>
            <p class="text-sm text-muted-500 dark:text-muted-400 mb-10 md:mb-0">
              Diseñado e implementado para ser un sistema escalable para gestionar las operaciones hospitalarias de forma eficiente.
            </p>
          </div>
        </div>
        <div class="lg:w-1/6 ltablet:w-1/6 md:w-1/2 w-full px-4">
          <h2
            class="font-medium tracking-widest text-sm mb-5 text-muted-800 dark:text-muted-100"
          >
            Recursos
          </h2>
          <ul class="list-none space-y-3 mb-10">
            <li>
              <a
                href="#"
                class="text-sm text-muted-500 dark:text-muted-400 hover:text-primary-500 dark:hover:text-primary-500 transition-colors duration-300"
                >Documentación</a
              >
            </li>
          </ul>
        </div>
        <div class="lg:w-1/6 ltablet:w-1/6 md:w-1/2 w-full px-4">
          <h2
            class="font-medium tracking-widest text-sm mb-5 text-muted-800 dark:text-muted-100"
          >
            Desarrolladores
          </h2>
          <ul class="list-none space-y-3 mb-10">
            <li>
              <a
                href="#"
                class="text-sm text-muted-500 dark:text-muted-400 hover:text-primary-500 dark:hover:text-primary-500 transition-colors duration-300"
                >Nexar Salguero</a
              >
            </li>
            <li>
              <a
                href="#"
                class="text-sm text-muted-500 dark:text-muted-400 hover:text-primary-500 dark:hover:text-primary-500 transition-colors duration-300"
                >David Sanguano</a
              >
            </li>
                      <li>
          
                          </li>
          </ul>
        </div>
      </div>
    </div>
  </Container>
  <div class="border-t border-muted-200 dark:border-muted-800">
    <Container>
      <div class="px-5 py-8 flex flex-col md:flex-row mx-auto items-center">
        <div
          class="w-full ltablet:w-auto lg:w-auto flex flex-col md:flex-row items-center justify-center md:justify-start gap-y-2"
        >
         
        
          <a
          href="/login"
          class="w-full md:w-auto h-10 inline-flex items-center justify-center text-white bg-primary-600 border-0 py-2 px-6 focus:outline-none hover:bg-primary-700 rounded-lg"
          >Acceso Administrador</a
        >
          <p
            class="text-muted-500 text-sm md:ml-2 md:mt-0 mt-2 sm:text-left text-center"
          >
            Gestionar Usuarios y Roles
          </p>
        </div>
        <span
          class="inline-flex ltablet:ml-auto lg:ml-auto md:mt-0 mt-6 w-full justify-center md:justify-start md:w-auto"
        >
          <a href="#" class="text-muted-500">
            <iconify-icon class="iconify w-5 h-5 flex items-center justify-center text-md" icon="fa6-brands:facebook-f"></iconify-icon>
          </a>
          <a href="#" class="ml-3 text-muted-500">
            <iconify-icon class="iconify w-5 h-5 flex items-center justify-center text-md" icon="fa6-brands:twitter"></iconify-icon>
          </a>
          <a href="#" class="ml-3 text-muted-500">
            <iconify-icon class="iconify w-5 h-5 flex items-center justify-center text-md" icon="fa6-brands:instagram"></iconify-icon>
          </a>
          <a href="#" class="ml-3 text-muted-500">
            <iconify-icon class="iconify w-5 h-5 flex items-center justify-center text-md" icon="fa6-brands:linkedin-in"></iconify-icon>
          </a>
        </span>
      </div>
    </Container>
  </div>

  <div class="bg-muted-100 dark:bg-muted-800">
    <Container>
      <div class="py-4 px-5 flex flex-wrap flex-col sm:flex-row">
        <p
          class="text-muted-500 dark:text-muted-400 text-sm text-center sm:text-left"
        >
          © 2018-{new Date().getFullYear()} All Rights Reserved —
          <a
            href="Nexar David"
            class="hover:text-primary-500"
            target="_blank"
            rel="noopener noreferrer">Nexar David</a
          >
        </p>
        <span
          class="sm:ml-auto sm:mt-0 mt-2 sm:w-auto w-full sm:text-left text-center text-muted-500 dark:text-muted-400 text-sm"
          >Built with <a href="https://astro.build" class="hover:text-primary-500"
            >Astro.build</a
          >
        </span>
      </div>
    </Container>
  </div>
</footer>
