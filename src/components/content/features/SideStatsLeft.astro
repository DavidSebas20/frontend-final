---
import MockupTwo from '@components/mockup/MockupTwo.astro'
---

<div class="flex flex-col-reverse md:flex-row items-center py-6">
  <!--Column-->
  <div class="w-full md:w-1/2 relative p-6">
    <!--Feature-->
    <MockupTwo />
  </div>

  <!--Column-->
  <div class="w-full md:w-1/2 relative p-6">
    <!--Section content-->
    <div class="w-full max-w-lg space-y-4">
      <!--Badge-->
      <h4 class="font-sans font-semibold text-xs tracking-widest uppercase mb-3 text-primary-500">Conversaciones remotas</h4>
      <!--Title-->
      <h2 class="font-heading font-medium
          text-4xl text-muted-800
          dark:text-white">Utiliza la mensajería para mantenerte al día con tu profesional</h2>
      <!--Subtitle-->
      <p class="font-sans text-lg text-muted-500 dark:text-muted-400">
        Comunicación fluida y eficiente en todo momento.
      </p>
      <!--Link-->
      <a href="https://www.maniapurefoundation.org/post/telemedicina-que-es?gad_source=1&gclid=CjwKCAiA5Ka9BhB5EiwA1ZVtvAX9S6-ZYPJcSABz8BHM5ZNYxbZV8eAsvZPG7BW02l5EqzeudM_XAxoC6A8QAvD_BwE" class="group
          inline-flex
          items-center
          gap-4
          text-primary-500
          hover:text-primary-400
          transition-colors
          duration-300">
        <span class="font-sans font-medium text-sm"> Saber más acerca de la Telemedicina </span>
        <iconify-icon class="iconify w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" icon="lucide:arrow-right"></iconify-icon>
      </a>
    </div>
  </div>
</div>
