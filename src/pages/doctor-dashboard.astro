---
// src/pages/DoctorDashboard.astro
import AdminLayout from "@layouts/adminlayout.astro";
import SectionTitle from "@components/section/SectionTitle.astro";
import ButtonMain from "@components/base/ButtonMain.astro";
import Table from "@components/content/Table.astro"; // Componente de tabla

const appointments = [
  { id: 1, patient: "John Doe", date: "2023-10-15", time: "10:00 AM", status: "Confirmed" },
  { id: 2, patient: "Jane Smith", date: "2023-10-16", time: "11:30 AM", status: "Pending" },
  { id: 3, patient: "Alice Johnson", date: "2023-10-17", time: "02:00 PM", status: "Cancelled" },
];

const metrics = {
  totalAppointments: 45,
  confirmedAppointments: 30,
  pendingAppointments: 10,
  cancelledAppointments: 5,
};
---

<AdminLayout title="Doctor Dashboard">
  <div class="py-10">
    <!-- Título del dashboard -->
    <div class="flex justify-between items-center mb-8">
      <SectionTitle
        title="Doctor Dashboard"
        subtitle="Welcome back, Dr. John Doe! Here's an overview of your schedule."
      />
      <!-- Botón de cerrar sesión -->
      <ButtonMain to="/logout" variant="secondary" class="'w-32'">Logout</ButtonMain>
    </div>

    <!-- Sección de métricas -->
    <SectionTitle
      title="Your Metrics"
      subtitle="Track your performance and upcoming appointments."
      class="'mb-6'"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
      <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6 text-center">
        <h3 class="text-xl font-semibold text-slate-700 dark:text-slate-300">Total Appointments</h3>
        <p class="text-2xl font-bold text-primary-600">{metrics.totalAppointments}</p>
      </div>
      <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6 text-center">
        <h3 class="text-xl font-semibold text-slate-700 dark:text-slate-300">Confirmed Appointments</h3>
        <p class="text-2xl font-bold text-green-500">{metrics.confirmedAppointments}</p>
      </div>
      <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6 text-center">
        <h3 class="text-xl font-semibold text-slate-700 dark:text-slate-300">Pending Appointments</h3>
        <p class="text-2xl font-bold text-yellow-500">{metrics.pendingAppointments}</p>
      </div>
      <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6 text-center">
        <h3 class="text-xl font-semibold text-slate-700 dark:text-slate-300">Cancelled Appointments</h3>
        <p class="text-2xl font-bold text-red-500">{metrics.cancelledAppointments}</p>
      </div>
    </div>

    <!-- Tabla de citas -->
    <SectionTitle
      title="Your Appointments"
      subtitle="Manage your upcoming and past appointments."
      class="'mb-6'"
    />

    <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6">
      <Table>
        <thead>
          <tr>
            <th>Patient Name</th>
            <th>Date</th>
            <th>Time</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {appointments.map((appointment) => (
            <tr id={`appointment-${appointment.id}`}>
              <td>{appointment.patient}</td>
              <td>{appointment.date}</td>
              <td>{appointment.time}</td>
              <td>
                <span
                  class={`inline-block px-2 py-1 rounded-full text-sm font-medium ${
                    appointment.status === "Confirmed"
                      ? "bg-green-100 text-green-800"
                      : appointment.status === "Pending"
                      ? "bg-yellow-100 text-yellow-800"
                      : "bg-red-100 text-red-800"
                  }`}
                >
                  {appointment.status}
                </span>
              </td>
              <td>
                <select
                  class="block w-full px-3 py-2 border border-slate-300 dark:border-slate-700 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
                  value={appointment.status}
                  onchange={`handleStatusChange(${appointment.id}, this.value)`}
                >
                  <option value="Confirmed">Confirmed</option>
                  <option value="Pending">Pending</option>
                  <option value="Cancelled">Cancelled</option>
                </select>
              </td>
            </tr>
          ))}
        </tbody>
      </Table>
    </div>
  </div>

  <!-- Script para manejar eventos -->
  <script>
    const handleStatusChange = (id, newStatus) => {
      console.log(`Appointment ${id} status changed to ${newStatus}`);
      // Aquí puedes enviar la actualización al backend usando fetch o Axios
    };
  </script>
</AdminLayout>