---
// src/pages/PatientAppointments.astro
import AdminLayout from "@layouts/adminlayout.astro";
import SectionTitle from "@components/section/SectionTitle.astro";
import ButtonMain from "@components/base/ButtonMain.astro";
import Table from "@components/content/Table.astro"; // Componente de tabla

const BASE_URL = "http://appointment-alb-212598074.us-east-1.elb.amazonaws.com"; // URL del backend
let appointments = [];
const patientId = Astro.props.patientId; // ID del paciente (puede ser pasado como prop)

// Función para cargar las citas del paciente
const loadAppointments = async () => {
  try {
    const response = await fetch(`${BASE_URL}/read-appointment/appointments/patient/${patientId}`);
    if (!response.ok) {
      throw new Error(`Error al cargar las citas: ${response.statusText}`);
    }
    appointments = await response.json();
  } catch (error) {
    console.error("Error al cargar las citas:", error.message);
    alert("Hubo un error al cargar las citas. Por favor, inténtalo de nuevo.");
  }
};

// Cargar las citas al iniciar la página
await loadAppointments();
---

<AdminLayout title="Patient Appointments">
  <div class="py-10">
    <!-- Título del dashboard -->
    <div class="flex justify-between items-center mb-8">
      <SectionTitle
        title="Patient Appointments"
        subtitle="Manage appointments for the selected patient."
      />
      <!-- Botón para crear una nueva cita -->
      <ButtonMain onclick="window.app.createAppointment()" variant="primary" class="w-32">
        New Appointment
      </ButtonMain>
    </div>

    <!-- Tabla de citas -->
    <SectionTitle
      title="Appointments"
      subtitle="View and manage existing appointments."
      class="mb-6 mt-10"
    />
    <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6">
      <Table>
        <!-- Encabezado de la tabla -->
        <thead slot="thead">
          <tr>
            <th class="px-4 py-2">Date</th>
            <th class="px-4 py-2">Time</th>
            <th class="px-4 py-2">Doctor</th>
            <th class="px-4 py-2">Reason</th>
            <th class="px-4 py-2">Actions</th>
          </tr>
        </thead>
        <!-- Cuerpo de la tabla -->
        <tbody slot="tbody">
          {appointments.map((appointment) => (
            <tr
              id={`appointment-${appointment.id}`}
              class="hover:bg-slate-100 dark:hover:bg-muted-800"
            >
              <td class="px-4 py-2">{appointment.date}</td>
              <td class="px-4 py-2">{appointment.time}</td>
              <td class="px-4 py-2">{appointment.doctorName}</td>
              <td class="px-4 py-2">{appointment.reason}</td>
              <td class="px-4 py-2">
                <button
                  data-id={appointment.id}
                  class="w-24 bg-blue-500 text-white rounded-md px-4 py-2 edit-appointment"
                >
                  Edit
                </button>
                <button
                  data-id={appointment.id}
                  class="w-24 bg-red-500 text-white rounded-md px-4 py-2 ml-2 delete-appointment"
                >
                  Delete
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </Table>
    </div>
  </div>

  <!-- Script para manejar eventos -->
  <script>
    const BASE_URL = "http://appointment-alb-212598074.us-east-1.elb.amazonaws.com"; // URL del backend
    const PATIENT_ID = "{patientId}";

    // Crear un objeto global para exponer las funciones
    window.app = {
      createAppointment: async () => {
        const date = prompt("Enter appointment date (YYYY-MM-DD):");
        const time = prompt("Enter appointment time (HH:mm):");
        const doctorName = prompt("Enter doctor's name:");
        const reason = prompt("Enter reason for the appointment:");

        if (!date || !time || !doctorName || !reason) {
          alert("All fields are required to create an appointment.");
          return;
        }

        try {
          const response = await fetch(`${BASE_URL}/create-appointment`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              patientId: PATIENT_ID,
              date,
              time,
              doctorName,
              reason,
            }),
          });

          if (!response.ok) {
            throw new Error(`Error creating appointment: ${response.statusText}`);
          }

          alert("Appointment created successfully!");
          location.reload(); // Recargar la página para reflejar los cambios
        } catch (error) {
          console.error("Error creating appointment:", error.message);
          alert("There was an error creating the appointment. Please try again.");
        }
      },

      editAppointment: async (id) => {
        const date = prompt("Enter new appointment date (YYYY-MM-DD):");
        const time = prompt("Enter new appointment time (HH:mm):");
        const doctorName = prompt("Enter new doctor's name:");
        const reason = prompt("Enter new reason for the appointment:");

        if (!date || !time || !doctorName || !reason) {
          alert("All fields are required to update the appointment.");
          return;
        }

        try {
          const response = await fetch(`${BASE_URL}/update-appointment/${id}`, {
            method: "PUT",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              date,
              time,
              doctorName,
              reason,
            }),
          });

          if (!response.ok) {
            throw new Error(`Error updating appointment: ${response.statusText}`);
          }

          alert("Appointment updated successfully!");
          location.reload(); // Recargar la página para reflejar los cambios
        } catch (error) {
          console.error("Error updating appointment:", error.message);
          alert("There was an error updating the appointment. Please try again.");
        }
      },

      deleteAppointment: async (id) => {
        const isConfirmed = confirm("Are you sure you want to delete this appointment?");
        if (!isConfirmed) return;

        try {
          const response = await fetch(`${BASE_URL}/delete-appointment/${id}`, {
            method: "DELETE",
          });

          if (!response.ok) {
            throw new Error(`Error deleting appointment: ${response.statusText}`);
          }

          alert("Appointment deleted successfully!");
          const row = document.getElementById(`appointment-${id}`);
          if (row) {
            row.remove();
          }
        } catch (error) {
          console.error("Error deleting appointment:", error.message);
          alert("There was an error deleting the appointment. Please try again.");
        }
      },
    };

   // Asignar eventos a los botones usando addEventListener
document.addEventListener("DOMContentLoaded", () => {
  // Botones de edición
  document.querySelectorAll(".edit-appointment").forEach((button) => {
    const appointmentId = (button as HTMLButtonElement).dataset.id; // Type casting aquí
    button.addEventListener("click", () => window.app.editAppointment(appointmentId));
  });

  // Botones de eliminación
  document.querySelectorAll(".delete-appointment").forEach((button) => {
    const appointmentId = (button as HTMLButtonElement).dataset.id; // Type casting aquí
    button.addEventListener("click", () => window.app.deleteAppointment(appointmentId));
  });
});
    // Extender la interfaz Window para incluir la propiedad app
    declare global {
      interface Window {
        app: {
          createAppointment: () => Promise<void>;
          editAppointment: (id: string) => Promise<void>;
          deleteAppointment: (id: string) => Promise<void>;
        };
      }
    }
  </script>
</AdminLayout>