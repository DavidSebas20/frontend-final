---
// src/pages/PatientDashboard.astro
import AdminLayout from "@layouts/adminlayout.astro";
import SectionTitle from "@components/section/SectionTitle.astro";
import ButtonMain from "@components/base/ButtonMain.astro";
import Table from "@components/content/Table.astro"; // Componente de tabla

const doctors = [
  { id: 1, name: "Dr. John Doe", specialty: "Cardiology" },
  { id: 2, name: "Dr. Jane Smith", specialty: "Dermatology" },
  { id: 3, name: "Dr. Alice Johnson", specialty: "Pediatrics" },
];

const appointments = [
  { id: 1, doctor: "Dr. John Doe", date: "2023-10-15", time: "10:00 AM", status: "Confirmed" },
  { id: 2, doctor: "Dr. Jane Smith", date: "2023-10-16", time: "11:30 AM", status: "Pending" },
];

const metrics = {
  totalAppointments: 2,
  confirmedAppointments: 1,
  pendingAppointments: 1,
  cancelledAppointments: 0,
};
---

<AdminLayout title="Patient Dashboard">
  <div class="py-10">
    <!-- Título del dashboard -->
    <div class="flex justify-between items-center mb-8">
      <SectionTitle
        title="Patient Dashboard"
        subtitle="Welcome back, John Doe! Here's an overview of your appointments."
      />
      <!-- Botón de cerrar sesión -->
      <ButtonMain to="/logout" variant="secondary" class="'w-32'">Logout</ButtonMain>
    </div>

    <!-- Sección de métricas -->
    <SectionTitle
      title="Your Metrics"
      subtitle="Track your upcoming and past appointments."
      class="'mb-6'"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
      <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6 text-center">
        <h3 class="text-xl font-semibold text-slate-700 dark:text-slate-300">Total Appointments</h3>
        <p class="text-2xl font-bold text-primary-600">{metrics.totalAppointments}</p>
      </div>
      <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6 text-center">
        <h3 class="text-xl font-semibold text-slate-700 dark:text-slate-300">Confirmed Appointments</h3>
        <p class="text-2xl font-bold text-green-500">{metrics.confirmedAppointments}</p>
      </div>
      <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6 text-center">
        <h3 class="text-xl font-semibold text-slate-700 dark:text-slate-300">Pending Appointments</h3>
        <p class="text-2xl font-bold text-yellow-500">{metrics.pendingAppointments}</p>
      </div>
      <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6 text-center">
        <h3 class="text-xl font-semibold text-slate-700 dark:text-slate-300">Cancelled Appointments</h3>
        <p class="text-2xl font-bold text-red-500">{metrics.cancelledAppointments}</p>
      </div>
    </div>

    <!-- Formulario para crear una cita -->
    <SectionTitle
      title="Book an Appointment"
      subtitle="Schedule a new appointment with your preferred doctor."
      class="'mb-6'"
    />

    <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6">
      <form id="appointment-form" class="space-y-4">
        <div>
          <label for="doctor" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Doctor</label>
          <select
            id="doctor"
            name="doctor"
            required
            class="mt-1 block w-full px-3 py-2 border border-slate-300 dark:border-slate-700 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
          >
            <option value="">Select a doctor</option>
            {doctors.map((doctor) => (
              <option value={doctor.name}>
                {doctor.name} ({doctor.specialty})
              </option>
            ))}
          </select>
        </div>
        <div>
          <label for="date" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Date</label>
          <input
            type="date"
            id="date"
            name="date"
            required
            class="mt-1 block w-full px-3 py-2 border border-slate-300 dark:border-slate-700 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
          />
        </div>
        <div>
          <label for="time" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Time</label>
          <input
            type="time"
            id="time"
            name="time"
            required
            class="mt-1 block w-full px-3 py-2 border border-slate-300 dark:border-slate-700 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
          />
        </div>
        <div>
          <button type="submit" class="w-full bg-primary-500 text-white rounded-md px-4 py-2">
            Book Appointment
          </button>
        </div>
      </form>
    </div>

    <!-- Tabla de citas -->
    <SectionTitle
      title="Your Appointments"
      subtitle="Manage your upcoming and past appointments."
      class="'mb-6 mt-10'"
    />

    <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6">
      <Table>
        <thead>
          <tr>
            <th>Doctor</th>
            <th>Date</th>
            <th>Time</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {appointments.map((appointment) => (
            <tr id={`appointment-${appointment.id}`}>
              <td>{appointment.doctor}</td>
              <td>{appointment.date}</td>
              <td>{appointment.time}</td>
              <td>
                <span
                  class={`inline-block px-2 py-1 rounded-full text-sm font-medium ${
                    appointment.status === "Confirmed"
                      ? "bg-green-100 text-green-800"
                      : appointment.status === "Pending"
                      ? "bg-yellow-100 text-yellow-800"
                      : "bg-red-100 text-red-800"
                  }`}
                >
                  {appointment.status}
                </span>
              </td>
              <td>
                <ButtonMain
                  onclick={`handleCancelAppointment(${appointment.id})`}
                  size="small"
                  variant="danger"
                  class="'w-24'"
                >
                  Cancel
                </ButtonMain>
              </td>
            </tr>
          ))}
        </tbody>
      </Table>
    </div>
  </div>

  <!-- Script para manejar eventos -->
  <script>
    const handleCreateAppointment = (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const appointmentData = {
        doctor: formData.get("doctor"),
        date: formData.get("date"),
        time: formData.get("time"),
      };
      console.log("New appointment created:", appointmentData);
      // Aquí puedes enviar los datos al backend para guardar la cita
    };

    const handleCancelAppointment = (id) => {
      console.log(`Appointment ${id} cancelled`);
      // Aquí puedes enviar una solicitud al backend para cancelar la cita
    };

    // Asignar el evento onsubmit al formulario
    document.getElementById("appointment-form").addEventListener("submit", handleCreateAppointment);
  </script>
</AdminLayout>