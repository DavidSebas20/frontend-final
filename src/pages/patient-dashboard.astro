---
// Importaciones de componentes y estilos
import AdminLayout from "@layouts/adminlayout.astro";
import SectionTitle from "@components/section/SectionTitle.astro";
import ButtonMain from "@components/base/ButtonMain.astro";
import Table from "@components/content/Table.astro"; // Componente de tabla

// Datos simulados de citas (pueden ser reemplazados por datos reales del backend)
const appointments = [
  { id: 1, doctorName: "Dr. Carlos López", date: "2023-12-01", time: "14:30 PM", status: "PENDING" },
  { id: 2, doctorName: "Dra. Ana Pérez", date: "2023-12-05", time: "10:00 AM", status: "CONFIRMED" },
];
---
<AdminLayout title="Patient Dashboard">
  <div class="py-10">
    <!-- Título del dashboard -->
    <div class="flex justify-between items-center mb-8">
      <SectionTitle
        title="Patient Dashboard"
        subtitle="Welcome back! Here's an overview of your medical appointments."
      />
      <!-- Botón de cerrar sesión -->
      <ButtonMain to="/logout" variant="secondary" class="'w-32'"></ButtonMain>
    </div>

    <!-- Tabla de citas -->
    <SectionTitle
      title="Your Appointments"
      subtitle="Manage your upcoming and past appointments."
      class="'mb-6'"
    />
    <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6">
      <Table>
        <thead>
          <tr>
            <th>Doctor Name</th>
            <th>Date</th>
            <th>Time</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {appointments.map((appointment) => (
            <tr id={`appointment-${appointment.id}`}>
              <td>{appointment.doctorName}</td>
              <td>{appointment.date}</td>
              <td>{appointment.time}</td>
              <td>
                <span
                  class={`inline-block px-2 py-1 rounded-full text-sm font-medium ${
                    appointment.status === "CONFIRMED"
                      ? "bg-green-100 text-green-800"
                      : appointment.status === "PENDING"
                      ? "bg-yellow-100 text-yellow-800"
                      : "bg-red-100 text-red-800"
                  }`}
                >
                  {appointment.status}
                </span>
              </td>
              <td>
                <select
                  class="block w-full px-3 py-2 border border-slate-300 dark:border-slate-700 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
                  value={appointment.status}
                  onchange={`handleStatusChange(${appointment.id}, this.value)`}
                >
                  <option value="CONFIRMED">Confirmed</option>
                  <option value="PENDING">Pending</option>
                  <option value="CANCELLED">Cancelled</option>
                </select>
              </td>
            </tr>
          ))}
        </tbody>
      </Table>
    </div>

    <!-- Botón para crear citas -->
    <a href="/formulario" class="bg-blue-500 text-white px-6 py-3 rounded-lg shadow-md hover:bg-blue-600 transition duration-300 text-center">
      Create Appointment
    </a>

    <!-- Formulario para crear citas -->
    <div id="appointment-form" class="hidden mt-6 w-full max-w-md bg-white p-6 rounded-lg shadow-lg">
      <h2 class="text-xl font-bold mb-4">Create New Appointment</h2>
      <form
        action="/create-appointment/appointments"
        method="POST"
        class="space-y-4"
      >
        <!-- Nombre del Doctor -->
        <div>
          <label for="doctorName" class="block text-sm font-medium text-gray-700">Doctor Name</label>
          <input
            type="text"
            id="doctorName"
            name="doctorName"
            required
            class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
          />
        </div>

        <!-- Fecha y Hora de la Cita -->
        <div>
          <label for="appointmentDateTime" class="block text-sm font-medium text-gray-700">Date and Time</label>
          <input
            type="datetime-local"
            id="appointmentDateTime"
            name="appointmentDateTime"
            required
            class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
          />
        </div>

        <!-- Estado de la Cita -->
        <div>
          <label for="status" class="block text-sm font-medium text-gray-700">Status</label>
          <select
            id="status"
            name="status"
            required
            class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
          >
            <option value="PENDING">Pending</option>
            <option value="CONFIRMED">Confirmed</option>
            <option value="CANCELLED">Cancelled</option>
          </select>
        </div>

        <!-- Botón de Envío -->
        <button
          type="submit"
          class="w-full bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 transition duration-300"
        >
          Save Appointment
        </button>
      </form>
    </div>
  </div>

  <!-- Script para manejar eventos -->
  <script>
    const showForm = () => {
      const form = document.getElementById('appointment-form');
      if (form) {
        form.classList.toggle('hidden');
      } else {
        console.error("El formulario con ID 'appointment-form' no existe.");
      }
    };

    const handleStatusChange = (id, newStatus) => {
      console.log(`Appointment ${id} status changed to ${newStatus}`);
      // Aquí puedes enviar la actualización al backend usando fetch o Axios
    };
  </script>
</AdminLayout>