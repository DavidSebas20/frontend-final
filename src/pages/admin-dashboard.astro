---
// src/pages/AdminDashboard.astro
import AdminLayout from "@layouts/adminlayout.astro";
import SectionTitle from "@components/section/SectionTitle.astro";
import ButtonMain from "@components/base/ButtonMain.astro";

const doctors = [
  { id: 1, name: "Dr. John Doe", email: "john.doe@example.com", specialty: "Cardiology" },
  { id: 2, name: "Dr. Jane Smith", email: "jane.smith@example.com", specialty: "Dermatology" },
  { id: 3, name: "Dr. Alice Johnson", email: "alice.johnson@example.com", specialty: "Pediatrics" },
];

const metrics = {
  totalVisits: 12345,
  activeUsers: 890,
  systemUptime: "99.9%",
  averageLoadTime: "1.2s",
};
---
<AdminLayout title="Admin Dashboard">
  <div class="py-10">
    <!-- Título del dashboard -->
    <div class="flex justify-between items-center mb-8">
      <SectionTitle
        title="Admin Dashboard"
        subtitle="Manage your doctors and monitor your platform."
      />
      <!-- Botón para agregar un nuevo doctor -->
      <ButtonMain id="add-doctor-btn" class="'w-40'">Add Doctor</ButtonMain>
      <!-- Botón de logout -->
      <ButtonMain to="/logout" variant="secondary" class="'w-32 ml-4'">Logout</ButtonMain>
    </div>

    <!-- Sección de métricas -->
    <SectionTitle
      title="Platform Metrics"
      subtitle="Monitor the performance and usage of your platform."
      class="'mb-6'"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
      <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6 text-center">
        <h3 class="text-xl font-semibold text-slate-700 dark:text-slate-300">Total Visits</h3>
        <p class="text-2xl font-bold text-primary-600">{metrics.totalVisits}</p>
      </div>
      <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6 text-center">
        <h3 class="text-xl font-semibold text-slate-700 dark:text-slate-300">Active Users</h3>
        <p class="text-2xl font-bold text-green-500">{metrics.activeUsers}</p>
      </div>
      <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6 text-center">
        <h3 class="text-xl font-semibold text-slate-700 dark:text-slate-300">System Uptime</h3>
        <p class="text-2xl font-bold text-blue-500">{metrics.systemUptime}</p>
      </div>
      <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6 text-center">
        <h3 class="text-xl font-semibold text-slate-700 dark:text-slate-300">Average Load Time</h3>
        <p class="text-2xl font-bold text-rose-500">{metrics.averageLoadTime}</p>
      </div>
    </div>

    <!-- Tabla de doctores -->
    <SectionTitle
      title="Doctors Management"
      subtitle="List of all registered doctors."
      class="'mb-6'"
    />

    <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6">
      <table class="w-full text-sm text-left text-slate-700 dark:text-slate-300 border-collapse">
        <thead class="bg-slate-100 dark:bg-muted-800">
          <tr>
            <th class="px-6 py-3 font-medium text-slate-700 dark:text-slate-300">Name</th>
            <th class="px-6 py-3 font-medium text-slate-700 dark:text-slate-300">Email</th>
            <th class="px-6 py-3 font-medium text-slate-700 dark:text-slate-300">Specialty</th>
            <th class="px-6 py-3 font-medium text-slate-700 dark:text-slate-300">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-muted-700">
          {doctors.map((doctor) => (
            <tr id={`doctor-${doctor.id}`}>
              <td class="px-6 py-4">{doctor.name}</td>
              <td class="px-6 py-4">{doctor.email}</td>
              <td class="px-6 py-4">{doctor.specialty}</td>
              <td class="px-6 py-4">
                <button
                  onclick="openModal(${JSON.stringify(doctor)})"
                  class="w-20 bg-primary-500 text-white rounded-md px-4 py-2 mr-2"
                >
                  Edit
                </button>
                <button
                  onclick="handleDelete(${doctor.id})"
                  class="w-20 bg-red-500 text-white rounded-md px-4 py-2"
                >
                  Delete
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Modal para crear/editar doctor -->
    <div id="doctor-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 hidden">
      <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg w-full max-w-md p-6">
        <h2 class="text-xl font-semibold text-slate-700 dark:text-slate-300 mb-4" id="modal-title">
          Add Doctor
        </h2>
        <form id="doctor-form" class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="mt-1 block w-full px-3 py-2 border border-slate-300 dark:border-slate-700 rounded-md shadow-sm placeholder-slate-400 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="mt-1 block w-full px-3 py-2 border border-slate-300 dark:border-slate-700 rounded-md shadow-sm placeholder-slate-400 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
            />
          </div>
          <div>
            <label for="specialty" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Specialty</label>
            <input
              type="text"
              id="specialty"
              name="specialty"
              required
              class="mt-1 block w-full px-3 py-2 border border-slate-300 dark:border-slate-700 rounded-md shadow-sm placeholder-slate-400 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
            />
          </div>
          <div class="flex justify-end">
            <button type="submit" class="w-32 bg-primary-500 text-white rounded-md px-4 py-2">
              Save
            </button>
            <button
              type="button"
              onclick="closeModal()"
              class="w-32 ml-2 bg-gray-200 text-gray-700 rounded-md px-4 py-2"
            >
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Script para manejar eventos -->
  <script>
    let isModalOpen = false;
    let selectedDoctor = null;

    // Abrir el modal
    const openModal = (doctor = null) => {
      selectedDoctor = doctor;
      isModalOpen = true;

      const modal = document.getElementById("doctor-modal");
      const form = document.getElementById("doctor-form");
      const modalTitle = document.getElementById("modal-title");

      if (doctor) {
        // Rellenar el formulario con los datos del doctor seleccionado
        (form as HTMLFormElement).elements["name"].value = doctor.name;
        (form as HTMLFormElement).elements["email"].value = doctor.email;
        (form as HTMLFormElement).elements["specialty"].value = doctor.specialty;
        modalTitle.textContent = "Edit Doctor";
      } else {
        // Limpiar el formulario si es un nuevo doctor
        (form as HTMLFormElement).reset();
        modalTitle.textContent = "Add Doctor";
      }

      modal.style.display = "flex";
    };

    // Cerrar el modal
    const closeModal = () => {
      isModalOpen = false;
      selectedDoctor = null;

      const modal = document.getElementById("doctor-modal");
      modal.style.display = "none";
    };

    // Eliminar un doctor
    const handleDelete = async (id) => {
      try {
        const response = await fetch(`https://api-generator.retool.com/H4uVTz/doctors/${id}`, {
          method: "DELETE",
        });

        if (!response.ok) {
          throw new Error(`Error al eliminar el doctor: ${response.statusText}`);
        }

        alert(`Doctor con ID ${id} eliminado.`);
        window.location.reload(); // Refrescar la página
      } catch (error) {
        console.error("Error al eliminar el doctor:", error.message);
        alert("Hubo un error al eliminar el doctor. Por favor, inténtalo de nuevo.");
      }
    };

    // Guardar un doctor (crear o actualizar)
    document.getElementById("doctor-form").addEventListener("submit", async (e) => {
      e.preventDefault();

      const form = e.target;
      const name = (form as HTMLFormElement).elements["name"].value;
      const email = (form as HTMLFormElement).elements["email"].value;
      const specialty = (form as HTMLFormElement).elements["specialty"].value;

      const doctorData = {
        name: name,
        email: email,
        specialty: specialty,
      };

      try {
        let response;

        if (selectedDoctor) {
          // Actualizar un doctor existente
          response = await fetch(`https://api-generator.retool.com/H4uVTz/doctors/${selectedDoctor.id}`, {
            method: "PUT",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(doctorData),
          });
        } else {
          // Crear un nuevo doctor
          response = await fetch("https://api-generator.retool.com/H4uVTz/doctors", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(doctorData),
          });
        }

        if (!response.ok) {
          throw new Error(`Error al guardar el doctor: ${response.statusText}`);
        }

        alert(selectedDoctor ? "Doctor actualizado exitosamente." : "Doctor creado exitosamente.");
        closeModal();
        window.location.reload(); // Refrescar la página
      } catch (error) {
        console.error("Error al guardar el doctor:", error.message);
        alert("Hubo un error al guardar el doctor. Por favor, inténtalo de nuevo.");
      }
    });

    // Abrir el modal al hacer clic en "Add Doctor"
    document.getElementById("add-doctor-btn").addEventListener("click", () => {
      openModal();
    });
  </script>
</AdminLayout>