---
import Layout from "@layouts/Default.astro";
import ButtonMain from "@components/base/ButtonMain.astro";
import HeroMain from "@components/hero/HeroMain.astro";
import SectionMuted from "@components/section/SectionMuted.astro";
import Container from "@components/section/Container.astro";
import SectionTitle from "@components/section/SectionTitle.astro";
import IconBlock from "@components/content/IconBlock.astro";
import SideStatsRight from "@components/content/features/SideStatsRight.astro";
import SideStatsLeft from "@components/content/features/SideStatsLeft.astro";
import Testimonials from "@components/content/Testimonials.astro";
import Cta from "@components/content/Cta.astro";
---

<Layout title="Home">
  <HeroMain />

  <SectionMuted>
    <Container>
      <SectionTitle
        title="Hola familia"
        subtitle="Tu satisfacción es nuestra prioridad. Haremos todo lo posible para resolver cualquier problema que tengas."
        minititle="Atención médica personalizada"
      />

      <div class="grid md:grid-cols-3 ltablet:grid-cols-4 lg:grid-cols-4 gap-x-6 gap-y-12" x-intersect="activeStep = ''">
        <!-- Item -->
        <div>
          <IconBlock
            title="Ahorra tiempo y esfuerzo"
            text="Accede a la atención médica que necesitas sin largas esperas ni desplazamientos. Nuestro sistema está diseñado para optimizar tu tiempo y reducir el estrés asociado a las visitas médicas."
            icon="ph:timer-duotone"
            class="'text-primary-600'"
          />
        </div>
        <!-- Item -->
        <div>
          <IconBlock
            title="Profesionales seleccionados"
            text="Contamos con un equipo de médicos y especialistas altamente cualificados y con amplia experiencia.  Nos aseguramos de que recibas atención de los mejores profesionales para garantizar la calidad y eficacia de tu tratamiento."
            icon="ph:first-aid-duotone"
            class="'text-rose-500'"
          />
        </div>
        <!-- Item -->
        <div>
          <IconBlock
            title="Emergencias 24 horas"
            text="Estamos disponibles para ti las 24 horas del día, los 7 días de la semana, para cualquier emergencia médica.  Recibe atención oportuna y soporte inmediato cuando más lo necesitas"
            icon="ph:first-aid-kit-duotone"
            class="'text-primary-600'"
          />
        </div>
        <!-- Item -->
        <div>
          <IconBlock
            title="Servicios conectados"
            text="Integramos diversas áreas médicas para ofrecerte una atención integral y coordinada.  Desde el diagnóstico hasta el tratamiento, nuestros profesionales trabajan en conjunto para brindarte una atención personalizada y completa"
            icon="ph:heartbeat-duotone"
            class="'text-rose-500'"
          />
        </div>
        <!-- Item -->
        <div>
          <IconBlock
            title="Videoconsultas"
            text="Realiza consultas médicas desde la comodidad de tu hogar a través de videollamada.  Una forma fácil y rápida de recibir orientación médica y resolver tus dudas sin necesidad de desplazarte."
            icon="ph:video-camera-duotone"
            class="'text-primary-600'"
          />
        </div>
               <!-- Item -->
        <div>
          <IconBlock
            title="Citas"
            text="Reserva tus citas online de manera sencilla, eligiendo el médico, la fecha y la hora que mejor te convengan.  Nuestro sistema de reservas es intuitivo y te permite gestionar tus citas de forma rápida y eficiente."
            icon="ph:calendar-duotone"
            class="'text-primary-600'"
          />
        </div>
        <!-- Item -->
        <div>
          <IconBlock
            title="Medicamentos"
            text="Recibe los medicamentos que necesitas en la puerta de tu casa gracias a nuestro servicio de entrega a domicilio.  Una manera cómoda y segura de obtener tus medicinas sin tener que salir."
            icon="ph:pill-duotone"
            class="'text-primary-600'"
          />
        </div>
      </div>
    </Container>
  </SectionMuted>

  <SectionMuted class="'overflow-hidden'">
    <Container>
      <div class="py-10">
        <SideStatsRight />
        <SideStatsLeft />
      </div>
    </Container>
  </SectionMuted>

 

  <SectionMuted>
    <Container>
      <Cta />
    </Container>
  </SectionMuted>
</Layout>