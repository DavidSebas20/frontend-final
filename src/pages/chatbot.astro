---
import AdminLayout from "@layouts/adminlayout.astro";
import SectionTitle from "@components/section/SectionTitle.astro";
import ButtonMain from "@components/base/ButtonMain.astro";
---

<AdminLayout title="Medical Chatbot">
  <div class="py-10">
    <!-- Título del dashboard -->
    <div class="flex justify-between items-center mb-8">
      <SectionTitle
        title="Medical Chatbot"
        subtitle="Ask questions about patient #2's medical history."
      />
      <ButtonMain to="/logout" variant="secondary" class="'w-32'">Logout</ButtonMain>
    </div>

    <!-- Interfaz del chatbot -->
    <div class="bg-white dark:bg-muted-900 rounded-lg shadow-lg p-6 h-[700px] flex flex-col">
      <!-- Área de conversación -->
      <div id="chat-area" class="flex-1 overflow-y-auto border-b border-slate-300 dark:border-slate-700 mb-4 p-2 space-y-2">
        <!-- Aquí se mostrarán los mensajes dinámicamente -->
      </div>

      <!-- Formulario para enviar mensajes -->
      <form id="chat-form" class="flex space-x-2 mt-4">
        <input
          type="text"
          id="user-input"
          placeholder="Type your question about patient #2..."
          class="flex-1 px-4 py-2 border border-slate-300 dark:border-slate-700 rounded-md focus:outline-none focus:ring-primary-500 focus:border-primary-500"
        />
        <button type="submit" class="bg-primary-500 text-white rounded-md px-4 py-2">
          Send
        </button>
      </form>
    </div>
  </div>

  <!-- Script para manejar eventos -->
  <script>
    const BASE_URL = "http://chatbot-alb-1703376079.us-east-1.elb.amazonaws.com/chat";

    // Agregar mensajes al chat con burbujas de estilo ChatGPT
    const addMessage = (sender, message) => {
      const chatArea = document.getElementById("chat-area");
      const messageContainer = document.createElement("div");
      messageContainer.classList.add("flex", "items-end");

      if (sender === "user") {
        messageContainer.classList.add("justify-end");
      } else {
        messageContainer.classList.add("justify-start");
      }

      const messageBubble = document.createElement("div");
      const classes = [
        "max-w-[75%]", "px-4", "py-2", "rounded-lg", "shadow-md",
        sender === "user" ? "bg-blue-100" : "bg-gray-100",
        sender === "user" ? "text-blue-800" : "text-gray-800",
        sender === "user" ? "self-end" : "self-start"
      ];

      classes.forEach(cls => messageBubble.classList.add(cls)); // Agregar clases correctamente
      messageBubble.innerHTML = message.replace(/\n/g, "<br>"); // Convertir saltos de línea en HTML
      messageContainer.appendChild(messageBubble);
      chatArea.appendChild(messageContainer);

      // Desplazar automáticamente hacia abajo
      chatArea.scrollTop = chatArea.scrollHeight;
    };

    // Enviar pregunta al backend
    const sendQuestionToChatbot = async (question) => {
      try {
        console.log("Enviando pregunta:", question);

        const response = await fetch(`${BASE_URL}`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            patient_id: 2,
            question: question,
          }),
        });

        if (!response.ok) {
          throw new Error(`Error HTTP ${response.status}: ${response.statusText}`);
        }

        const contentType = response.headers.get("content-type");
        if (!contentType || !contentType.includes("application/json")) {
          throw new Error("La respuesta no es JSON. Respuesta recibida: " + await response.text());
        }

        const data = await response.json();
        console.log("Respuesta del backend:", data);
        return data.answer || "No answer received.";
      } catch (error) {
        console.error("Error:", error.message);
        return "Error al obtener respuesta.";
      }
    };

    // Manejo del envío del formulario
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("chat-form");
      const userInput = document.getElementById("user-input") as HTMLInputElement;

      if (form && userInput) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();

          const userQuestion = userInput.value.trim();
          if (!userQuestion) {
            console.log("Pregunta vacía.");
            return;
          }

          addMessage("user", userQuestion);
          userInput.value = "";

          const chatbotResponse = await sendQuestionToChatbot(userQuestion);
          addMessage("chatbot", chatbotResponse);
        });
      } else {
        console.error("No se encontró el formulario o el input.");
      }
    });
  </script>
</AdminLayout>
